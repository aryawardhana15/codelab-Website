# ================================
# CodeLab Production Environment
# ================================
# Copy this file to .env.production and fill in your values

# Database Configuration
DB_USER=codelab_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=codelab_db

# Backend Configuration
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d
GROQ_API_KEY=your_groq_api_key_here

# Frontend Configuration
# Replace YOUR_VPS_IP with your actual Hostinger VPS IP address
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP/api

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SERVER_URL=
MINIO_BROWSER_REDIRECT_URL=